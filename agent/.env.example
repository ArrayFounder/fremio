# Port yang digunakan oleh agent
PORT=7432

# Path ke executable gphoto2 — ganti jika tidak ada di PATH
# Mac default: /usr/local/bin/gphoto2 atau /opt/homebrew/bin/gphoto2
# Windows (MSYS2): C:\msys64\mingw64\bin\gphoto2.exe
GPHOTO2_PATH=gphoto2

# Nama printer default — kosongkan untuk pakai printer default sistem
# Mac/Linux: nama dari `lpstat -a`
# Windows: nama dari Devices and Printers
DEFAULT_PRINTER=

# Log level: debug | info | warn | error
LOG_LEVEL=info
