# ── CLOUDFLARE R2 — penyimpanan foto ─────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="fremio-studio-photos"
# Public CDN URL untuk R2 bucket (Cloudflare R2 public domain)
R2_PUBLIC_URL="https://photos.fremio.id"

# ── MIDTRANS — payment gateway ────────────────────────────────────────────────
# Dapatkan dari https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-XXXXXXXXXXXXXXXX"
MIDTRANS_CLIENT_KEY="SB-Mid-client-XXXXXXXXXXXXXXXX"
# "sandbox" atau "production"
MIDTRANS_ENV="sandbox"
# URL webhook yang terdaftar di Midtrans dashboard
MIDTRANS_WEBHOOK_SECRET="your-midtrans-notification-secret"

# ── APP CONFIG ────────────────────────────────────────────────────────────────
# URL publik aplikasi studio (sama dengan NEXTAUTH_URL)
NEXT_PUBLIC_APP_URL="https://studio.fremio.id"
# Client key Midtrans diekspos ke browser untuk Snap.js
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_MIDTRANS_ENV="sandbox"

# ── SOCKET.IO — realtime (opsional, untuk local agent) ────────────────────────
# Port yang digunakan custom server untuk Socket.io
SOCKET_PORT="3001"

# ── LOCAL AGENT — bridge kamera & printer ─────────────────────────────────────
# Token rahasia untuk autentikasi agent ke Next.js API
AGENT_SECRET_TOKEN="GENERATE_RANDOM_TOKEN_HERE"
# Nama printer CUPS yang digunakan (jalankan `lpstat -p` untuk cek)
PRINTER_NAME="SELPHY_CP1500"
