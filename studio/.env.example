# ─────────────────────────────────────────────────────────────────────────────
# Fremio Studio — Environment Variables Template
# Salin file ini ke .env.local untuk development
# JANGAN commit .env.local ke git
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fremio_studio?schema=public"

# ── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Wajib: generate dengan `openssl rand -base64 32`
NEXTAUTH_SECRET="GENERATE_WITH_OPENSSL_RAND_BASE64_32"
# URL lengkap aplikasi (tanpa trailing slash)
NEXTAUTH_URL="https://studio.fremio.id"

