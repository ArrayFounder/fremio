{
  "name": "fremio-studio-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Fremio Studio Local Agent — bridge printer ke booth UI. Windows + macOS.",
  "main": "dist/server.js",
  "scripts": {
    "dev":      "ts-node src/server.ts",
    "build":    "tsc",
    "start":    "node dist/server.js",
    "pkg:win":  "pkg dist/server.js --target node18-win-x64 --output fremio-agent-win.exe",
    "pkg:mac":  "pkg dist/server.js --target node18-macos-arm64 --output fremio-agent-mac"
  },
  "bin": "dist/server.js",
  "dependencies": {
    "cors":            "^2.8.5",
    "express":         "^4.19.2",
    "pdf-to-printer":  "^1.2.1"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node":    "^20",
    "pkg":            "^5.8.1",
    "ts-node":        "^10.9.2",
    "typescript":     "^5"
  }
}
