{
  "name": "fremio-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "start:next": "next start",
    "launcher:build:win-lite": "bash scripts/build-windows-lite-launcher.sh",
    "launcher:check:win-lite": "ls -lh public/downloads/fremio-studio-launcher.exe",
    "app:sync-downloads": "node scripts/sync-windows-app-downloads.mjs",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@prisma/client": "^5.22.0",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.38.0",
    "gifenc": "^1.0.3",
    "html2canvas": "^1.4.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.8.0",
    "lz-string": "^1.5.0",
    "midtrans-client": "^1.3.1",
    "next": "14.2.18",
    "next-auth": "^4.24.8",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-colorful": "^5.6.1",
    "react-dom": "^18",
    "react-rnd": "^10.5.3",
    "recharts": "^3.8.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "swr": "^2.4.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.5.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.0",
    "typescript": "^5"
  }
}
